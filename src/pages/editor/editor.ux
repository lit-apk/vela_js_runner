  font-size: 18px;
  color: #ffffff;
  text-align: center;
  background-color: #292929;
}

.wide-key {
  width: 30%;
  height: 100%;
  margin-left: 1%;
  margin-right: 1%;
  border-radius: 50%;
  font-size: 17px;
  color: #ffffff;
  text-align: center;
  background-color: #333333;
