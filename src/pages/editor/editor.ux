    <div class="keyboard" if="{{ keyboardOpen }}">
      <div class="mode-row">
        <input class="mode" type="button" value="abc" onclick="setMode('abc')" />
        <input class="mode" type="button" value="ABC" onclick="setMode('ABC')" />
        <input class="mode" type="button" value="123" onclick="setMode('num')" />
        <input class="mode" type="button" value="{}" onclick="setMode('sym')" />
        <input class="mode" type="button" value="kw" onclick="setMode('word')" />
      </div>
      <div class="key-row">
        <input class="key" type="button" value="{{ k11 }}" onclick="append(k11)" />
        <input class="key" type="button" value="{{ k12 }}" onclick="append(k12)" />
        <input class="key" type="button" value="{{ k13 }}" onclick="append(k13)" />
        <input class="key" type="button" value="{{ k14 }}" onclick="append(k14)" />
